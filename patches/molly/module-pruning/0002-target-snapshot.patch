-    PluginCache.localBackups = LocalBackups(
-      snapshots.map { LocalBackup(name = "${it.name} - ${it.timestamp}", it.timestamp) }
-    )
-
-    return PluginResult.JsonResult(JsonUtil.toJson(PluginCache.localBackups))
-  }
