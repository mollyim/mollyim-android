-    super(parameters);
-    this.uuid = sentPaymentId;
-  }
-
-  @Override
-  public @Nullable byte[] serialize() {
-    return new JsonJobData.Builder()
-                   .putString(KEY_UUID, uuid.toString())
-                   .serialize();
