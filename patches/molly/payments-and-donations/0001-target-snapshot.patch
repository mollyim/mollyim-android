-  public MultiDeviceOutgoingPaymentSyncJob(@NonNull UUID sentPaymentId) {
-    this(new Parameters.Builder()
-                       .setQueue("MultiDeviceOutgoingPaymentSyncJob")
-                       .addConstraint(NetworkConstraint.KEY)
