-      throw new NotPushRegisteredException();
-    }
-
-    if (!SignalStore.account().isMultiDevice()) {
-      Log.i(TAG, "Not multi device, aborting...");
-      return;
-    }
-
-    PaymentTable.PaymentTransaction payment = SignalDatabase.payments().getPayment(uuid);
