-  fun onActivityResult(
-    requestCode: Int,
-    resultCode: Int,
-    data: Intent?,
-    expectedRequestCode: Int,
-    paymentRequestCallback: PaymentRequestCallback
-  ) {
-    if (requestCode != expectedRequestCode) {
-      return
-    }
-
-    when (resultCode) {
