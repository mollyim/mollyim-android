+                        .getPackageInfo(packageName, PackageManager.GET_SIGNATURES);
+
+        List<String> hashSet = new ArrayList<>();
+        for (Signature sig : packageInfo.signatures) {
+            hashSet.add(toHexStringWithColons(md.digest(sig.toByteArray())));
+        }
+        return (hashSet);
+    }
