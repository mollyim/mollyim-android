-    this.threadPackets  = new ConcurrentHashMap<>();
-    this.eventPackets   = new ConcurrentLinkedQueue<>();
-    this.eventCount     = new AtomicInteger(0);
-    this.eventListeners = new CopyOnWriteArrayList<>();
