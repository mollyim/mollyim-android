+      """
+          SELECT
+            _id,
+            shared_contacts
+          FROM message
+          WHERE shared_contacts NOT NULL
+        """
+    ).use { cursor ->
+      while (cursor.moveToNext()) {
+        var avatarReplaced = false
+
+        val id = cursor.requireLong("_id")
+        val serializedContacts = cursor.requireString("shared_contacts")
