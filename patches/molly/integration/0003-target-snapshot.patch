+            Boolean -> putBoolean(toKey, store.getBoolean(fromKey, false))
+            Int -> putInteger(toKey, store.getInteger(fromKey, 0))
+            Long -> putLong(toKey, store.getLong(fromKey, 0))
+            else -> error("Not implemented")
+          }
+          remove(fromKey)
+        }
+      }
+      apply()
+    }
