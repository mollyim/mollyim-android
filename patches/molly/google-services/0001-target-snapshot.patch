+    /** Writes a parcel. */
+    public static void writeParcel(
+            @NonNull Parcel p, int id, @Nullable Parcel val, boolean writeNull) {
+        if (val == null) {
+            if (writeNull) {
+                writeHeader(p, id, 0);
+            }
+            return;
+        }
+        int start = beginVariableData(p, id);
+        p.appendFrom(val, 0, val.dataSize());
+        finishVariableData(p, start);
+    }
