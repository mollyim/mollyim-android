+    private static void finishVariableData(Parcel p, int start) {
+        int end = p.dataPosition();
+        int size = end - start;
+        // The size is one int before start.
+        p.setDataPosition(start - 4);
+        p.writeInt(size);
+        p.setDataPosition(end);
+    }
