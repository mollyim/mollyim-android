+    static final int OBJECT_HEADER = 0x00004f45;
+
+    private SafeParcelWriter() {}
+
+    private static void writeHeader(Parcel p, int id, int size) {
+        if (size >= 0x0000ffff) {
+            p.writeInt(0xffff0000 | id);
+            p.writeInt(size);
+        } else {
+            p.writeInt((size << 16) | id);
+        }
+    }
