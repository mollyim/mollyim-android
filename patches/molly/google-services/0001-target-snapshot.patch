+     * Parcel.writeTypedArray(T[] val, parcelableFlags);
+     */
+    public static void writeParcelArray(
+            @NonNull Parcel p, int id, @Nullable Parcel[] val, boolean writeNull) {
+        if (val == null) {
+            if (writeNull) {
+                writeHeader(p, id, 0);
+            }
+            return;
