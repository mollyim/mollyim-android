+        int start = beginVariableData(p, id);
+        final int length = val.length;
+        p.writeInt(length);
+        for (int i = 0; i < length; i++) {
+            Parcel item = val[i];
+            if (item != null) {
+                p.writeInt(item.dataSize());
+                // custom part
+                p.appendFrom(item, 0, item.dataSize());
+            } else {
+                p.writeInt(0);
