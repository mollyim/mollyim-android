+  - type: input
+    id: device-model
+    attributes:
+      label: "Device Model"
+      description: "System Settings ► About Phone"
+      placeholder: "e.g. Pixel 9"
+    validations:
+      required: false
+  - type: input
+    id: android-version
+    attributes:
+      label: "Android Version"
+      description: "System Settings ► About Phone"
+      placeholder: "e.g. Android 14"
+    validations:
+      required: false
+  - type: input
+    id: debug-log
+    attributes:
+      label: "Link to Debug Log"
+      description: |
+        If possible, include a debug log: Molly app ► Settings ► Help ► Debug Log.
+        Copy the generated link here. Logs cover about 24 hours, so capture it soon after the issue occurs.
+      placeholder: "e.g. https://debuglogs.org/..."
+    validations:
+      required: false
